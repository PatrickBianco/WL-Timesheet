{
  "ConnectionStrings": {
    "Timesheet": "Server=YOUR-SQL-SERVER;Database=WLTimeSheet;Integrated Security=True;Encrypt=True;TrustServerCertificate=False"
  },
  "AllowedHosts": "localhost;timesheet.example.local",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:443",
        "Certificate": {
          "Subject": "timesheet.example.local",
          "Store": "My",
          "Location": "LocalMachine",
          "AllowInvalid": false
        }
      }
    }
  },
  "Logging": {
    "DiagnosticFile": {
      "Directory": "%ProgramData%\\WLTimeSheet\\Logs"
    }
  },
  "DataProtection": {
    "KeyDirectory": "%ProgramData%\\WLTimeSheet\\Keys"
  }
}
