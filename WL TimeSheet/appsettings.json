{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "DiagnosticFile": { "Enabled": true, "MaxFileSizeMB": 10, "RetentionDays": 30 }
  },
  "AllowedHosts": "localhost",
  "Timesheet": { "TimeZone": "Australia/Adelaide", "EditablePreviousDays": 3, "ReopenHours": 24 }
}
