<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/artifacts/publish-service/</PublishDir>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <EnableMsDeployAppOffline>false</EnableMsDeployAppOffline>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DefineConstants>$(DefineConstants);BUNDLED_DEPLOYMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings.json" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.Development.json;appsettings.ClientReview.json;web.config;dotnet-tools.json" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/**" ExcludeFromSingleFile="false" />
    <Content Update="deployment/appsettings.Production.json" Link="appsettings.Production.json" TargetPath="appsettings.Production.json" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="deployment/README.md" Link="README.md" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="deployment/Service.ps1" Link="Service.ps1" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="deployment/Update.ps1" Link="Update.ps1" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="deployment/update.settings.example.json" Link="update.settings.example.json" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
